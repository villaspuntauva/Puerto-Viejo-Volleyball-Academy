---
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { getLanguageAlternates, getLanguageHref } from '../data/locales';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  image?: string;
  noindex?: boolean;
  structuredData?: Record<string, unknown>;
  lang?: 'en' | 'es';
}

const {
  title,
  description,
  image,
  noindex = false,
  structuredData,
  lang = 'en',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const socialImage = image ? new URL(image, Astro.site).href : undefined;
const languageHref = getLanguageHref(Astro.url.pathname, lang);
const languageAlternates = getLanguageAlternates(Astro.url.pathname, lang);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#35105d" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {languageAlternates && (
      <>
        <link rel="alternate" hreflang="en" href={new URL(languageAlternates.english, Astro.site).href} />
        <link rel="alternate" hreflang="es" href={new URL(languageAlternates.spanish, Astro.site).href} />
      </>
    )}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link
      href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700;800&family=DM+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === 'es' ? 'es_CR' : 'en_US'} />
    <meta property="og:site_name" content="Puerto Viejo Volleyball Academy" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {socialImage && <meta property="og:image" content={socialImage} />}
    <meta name="twitter:card" content={socialImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {socialImage && <meta name="twitter:image" content={socialImage} />}
    {structuredData && (
      <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    )}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader lang={lang} languageHref={languageHref} />
    <main id="main">
      <slot />
    </main>
    <SiteFooter lang={lang} />
  </body>
</html>