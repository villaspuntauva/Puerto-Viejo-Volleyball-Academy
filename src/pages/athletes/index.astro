---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RosterView from '../../components/roster/RosterView.astro';
import { currentSeason } from '../../data/roster';
import { photoAttrs } from '../../data/photos';
const description = `Puerto Viejo Volleyball Academy ${currentSeason.label.en.toLowerCase()} roster: athlete photos, positions, hometowns, and full player profiles.`;
---

<BaseLayout title={`Athletes · ${currentSeason.label.en} | Puerto Viejo Volleyball Academy`} description={description} image={photoAttrs('athletesJump').src}>
  <RosterView season={currentSeason} />
</BaseLayout>
