---
import BaseLayout from '../layouts/BaseLayout.astro';
import CampsView from '../components/CampsView.astro';
import { photoAttrs } from '../data/photos';
const description = 'Visiting Puerto Viejo? Inquire about private and private-group beach volleyball training with PVVA, coaching and equipment provided. International camps are a future plan.';
---

<BaseLayout title="Visiting Athletes & Camps | PVVA" description={description} image={photoAttrs('caribbeanCourt').src}>
  <CampsView />
</BaseLayout>
