---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import { photoAttrs } from '../data/photos';

const description = 'Puerto Viejo Volleyball Academy training hours at Playa Cocles: sessions generally take place Monday–Saturday, between 3:00 and 5:30 p.m.';
---

<BaseLayout title="Training Hours | Puerto Viejo Volleyball Academy" description={description} image={photoAttrs('settingPractice').src}>
  <PageIntro eyebrow="Training / Playa Cocles" title="Make time for the next rep." number="04" photo="settingPractice" />
  <section class="content-section schedule-section">
    <div class="hours-block">
      <p class="eyebrow">Training hours</p>
      <h2>Monday–Saturday<br /><em>3:00–5:30 p.m.</em></h2>
      <p>Sessions generally take place Monday–Saturday, between 3:00 and 5:30 p.m. Contact PVVA to confirm current availability and your session time.</p>
    </div>
    <div class="schedule-details"><div><span>TRAINING AREA</span><strong>Playa Cocles, Puerto Viejo</strong></div><div><span>TIME ZONE</span><strong>Costa Rica Time · UTC−6</strong></div></div>
    <a class="button button-dark" href="https://wa.me/50660196290?text=Hi%20PVVA%2C%20can%20you%20confirm%20current%20availability%20and%20my%20session%20time%3F">Confirm your session time <span aria-hidden="true">↗</span></a>
  </section>
  <section class="content-section content-section-muted"><p class="eyebrow">New to training?</p><h2>Complete the Join PVVA process first.</h2><p class="section-lead">Athletes should register and confirm their program before attending a training session.</p><a class="text-link" href="/join/">Start an inquiry <span aria-hidden="true">→</span></a></section>
</BaseLayout>
