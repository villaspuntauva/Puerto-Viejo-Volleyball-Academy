---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
const description = 'Start the Puerto Viejo Volleyball Academy registration process. Contact PVVA first to discuss age group, experience, goals, availability, and program fit.';
---

<BaseLayout title="Join PVVA | Puerto Viejo Volleyball Academy" description={description}>
  <PageIntro eyebrow="Start here / Athlete registration" title="Make your move." description="Joining PVVA is a commitment to the academy and a training program. Start with a conversation so we can understand your goals and help find the right pathway." number="08" />
  <section class="join-layout">
    <div class="join-main"><p class="eyebrow">Before your first session</p><h2>Register first.<br /><em>Then get on court.</em></h2><p>Athletes should not attend training before completing the registration process and confirming their program with PVVA.</p><p>This draft does not collect personal details online. Contact the academy to begin registration and receive the appropriate next steps.</p><a class="button button-dark" href="https://wa.me/50664880471?text=Hi%20PVVA%2C%20I%27d%20like%20to%20start%20the%20athlete%20registration%20process.">Start registration on WhatsApp <span aria-hidden="true">↗</span></a><a class="text-link" href="mailto:pvvolleyballacademy@gmail.com?subject=PVVA%20athlete%20registration">Email the academy <span aria-hidden="true">→</span></a></div>
    <aside class="join-sidebar"><p class="eyebrow">We’ll discuss</p><ul><li>Athlete age and experience</li><li>Program interests and goals</li><li>Training availability</li><li>Parent or guardian involvement for minors</li><li>Next steps and any required forms</li></ul><p class="privacy-note">Please do not send emergency-contact details or other sensitive information in an initial message. PVVA can provide a secure registration process for those details.</p></aside>
  </section>
  <section class="content-section content-section-muted"><p class="eyebrow">Separate registration</p><h2>Camps, tournaments, and clinics</h2><p class="section-lead">Event registration will be provided with each confirmed event. No camp or tournament is currently open for registration.</p><div class="link-row"><a class="text-link" href="/camps/">Camp information <span aria-hidden="true">→</span></a><a class="text-link" href="/tournaments/">Tournament updates <span aria-hidden="true">→</span></a></div></section>
</BaseLayout>