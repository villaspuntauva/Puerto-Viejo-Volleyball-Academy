---
import BaseLayout from '../../layouts/BaseLayout.astro';

const description = 'Puerto Viejo Volleyball Academy desarrolla atletas de voleibol de playa mediante entrenamiento, competencia y comunidad en Playa Cocles, Puerto Viejo, Costa Rica.';
const organization = {
  '@context': 'https://schema.org',
  '@type': 'SportsOrganization',
  name: 'Puerto Viejo Volleyball Academy',
  alternateName: 'PVVA',
  url: 'https://www.pvvolleyballacademy.com/',
  description,
  email: 'pvvolleyballacademy@gmail.com',
  telephone: '+506 6488 0471',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Puerto Viejo de Talamanca',
    addressRegion: 'Limón',
    addressCountry: 'CR',
  },
  areaServed: ['Puerto Viejo', 'Limón', 'Costa Rica', 'Caribe'],
};
---

<BaseLayout lang="es" title="Puerto Viejo Volleyball Academy | Voleibol de playa en Costa Rica" description={description} image="https://images.unsplash.com/photo-1592656094267-764a45160876?auto=format&fit=crop&w=1200&q=80" structuredData={organization}>
  <section class="home-hero" aria-labelledby="hero-title">
    <img class="hero-photo" src="https://images.unsplash.com/photo-1592656094267-764a45160876?auto=format&fit=crop&w=1600&q=80" srcset="https://images.unsplash.com/photo-1592656094267-764a45160876?auto=format&fit=crop&w=640&q=75 640w, https://images.unsplash.com/photo-1592656094267-764a45160876?auto=format&fit=crop&w=1000&q=78 1000w, https://images.unsplash.com/photo-1592656094267-764a45160876?auto=format&fit=crop&w=1600&q=80 1600w" sizes="100vw" alt="Balón de voleibol de playa junto a la red sobre la arena" width="2200" height="1467" fetchpriority="high" />
    <div class="hero-shade"></div>
    <div class="hero-content">
      <p class="hero-kicker">Puerto Viejo Volleyball Academy</p>
      <h1 id="hero-title">Entrena.<br />Compite.<br /><em>Crece.</em></h1>
      <p class="hero-description">Desarrollo de voleibol de playa en el Caribe de Costa Rica.</p>
      <div class="hero-actions">
        <a class="button button-light" href="/es/inscripcion/">Únete a PVVA <span aria-hidden="true">↗</span></a>
        <a class="text-link text-link-light" href="/es/academia/">Conoce la academia <span aria-hidden="true">→</span></a>
      </div>
    </div>
    <div class="hero-side-note">Voleibol de playa <span>Playa Cocles · Limón · Costa Rica</span></div>
    <div class="draft-label">Foto provisional · reemplazar con imágenes de PVVA</div>
  </section>

  <section class="intro-band">
    <div class="section-index">01 / LA ACADEMIA</div>
    <div class="intro-content">
      <p class="eyebrow">Un lugar para desarrollarse</p>
      <h2>Voleibol de playa serio.<br /><span>Con raíces caribeñas.</span></h2>
      <div class="intro-columns">
        <p>Puerto Viejo Volleyball Academy está creando un entorno de voleibol de playa en el Caribe de Costa Rica para que los atletas entrenen, se desarrollen y compitan.</p>
        <p>Desde atletas en formación hasta jugadores competitivos, PVVA reúne a la comunidad mediante entrenamientos estructurados y una cultura de equipo.</p>
      </div>
      <a class="text-link" href="/es/academia/">Cómo funciona la academia <span aria-hidden="true">→</span></a>
    </div>
    <div class="intro-stamp" aria-hidden="true"><span>PVVA</span><small>CARIBE<br />COSTA RICA</small></div>
  </section>

  <section class="program-section" aria-labelledby="programs-title">
    <div class="section-heading">
      <div><p class="eyebrow">Encuentra tu camino</p><h2 id="programs-title">Tu próximo<br /><em>paso empieza aquí.</em></h2></div>
      <p>Atletas distintos. Metas distintas. El compromiso compartido de mejorar.</p>
    </div>
    <div class="program-grid">
      <article class="program-card"><span class="program-number">01</span><div><p class="program-audience">Atletas jóvenes y en desarrollo</p><h3>Future</h3><p>Una base para desarrollar habilidades, confianza y una mentalidad de equipo.</p></div><span class="program-status">Detalles por confirmar</span></article>
      <article class="program-card"><span class="program-number">02</span><div><p class="program-audience">Atletas avanzados y competitivos</p><h3>Premier</h3><p>Una ruta de mayor intensidad para atletas con objetivos de competencia.</p></div><span class="program-status">Detalles por confirmar</span></article>
      <article class="program-card"><span class="program-number">03</span><div><p class="program-audience">Desarrollo enfocado</p><h3>Individual</h3><p>Entrenamiento individual o en grupos pequeños según las metas del atleta.</p></div><span class="program-status">Disponibilidad por consulta</span></article>
      <article class="program-card"><span class="program-number">04</span><div><p class="program-audience">Desarrollo de habilidades</p><h3>Especializado</h3><p>Bloqueo, defensa, saque, ataque y preparación física; detalles por confirmar.</p></div><span class="program-status">Detalles por confirmar</span></article>
    </div>
    <a class="text-link" href="/es/academia/">Explorar los programas <span aria-hidden="true">→</span></a>
  </section>

  <section class="split-feature" aria-labelledby="destination-title">
    <div class="feature-image-wrap">
      <img src="https://images.unsplash.com/photo-1504450758481-7338eba7524a?auto=format&fit=crop&w=1200&q=80" srcset="https://images.unsplash.com/photo-1504450758481-7338eba7524a?auto=format&fit=crop&w=640&q=75 640w, https://images.unsplash.com/photo-1504450758481-7338eba7524a?auto=format&fit=crop&w=1200&q=80 1200w" sizes="(max-width: 820px) 100vw, 54vw" alt="Red de voleibol sobre una cancha de arena" width="1200" height="900" loading="lazy" />
      <span class="image-caption">COSTA CARIBEÑA · COSTA RICA</span><span class="draft-label draft-label-image">Foto provisional</span>
    </div>
    <div class="feature-copy"><p class="eyebrow">Entrena en el Caribe</p><h2 id="destination-title">Un lugar distinto<br />para jugar. Un lugar<br /><em>serio para crecer.</em></h2><p>La visión de PVVA es recibir a atletas, equipos y entrenadores en Puerto Viejo para entrenar voleibol de playa, participar en campamentos y competir.</p><a class="button button-outline" href="/es/campamentos/">Conocer campamentos <span aria-hidden="true">↗</span></a></div>
  </section>

  <section class="whats-on" aria-labelledby="whats-on-title">
    <div class="section-heading section-heading-compact"><div><p class="eyebrow">En la arena</p><h2 id="whats-on-title">Lo que viene</h2></div><a class="text-link" href="/es/eventos/">Eventos y novedades <span aria-hidden="true">→</span></a></div>
    <div class="event-placeholder"><span class="event-mark" aria-hidden="true">PVVA<br />HOY</span><div><p class="eyebrow">Próximamente</p><h3>Sigue el crecimiento de la academia.</h3><p>Los próximos campamentos, torneos y sesiones especiales se anunciarán aquí.</p></div><a class="button button-dark" href="https://wa.me/50664880471?text=Hola%20PVVA%2C%20quiero%20informaci%C3%B3n%20sobre%20pr%C3%B3ximos%20eventos.">Consultar eventos <span aria-hidden="true">↗</span></a></div>
  </section>

  <section class="coach-strip" aria-labelledby="coach-title">
    <div class="coach-number">PVVA<br />PERSONAS</div><div><p class="eyebrow">Quienes impulsan el programa</p><h2>Creada por la<br /><em>comunidad del voleibol.</em></h2></div>
    <div class="coach-highlight"><span class="coach-initials" aria-hidden="true">YB</span><div><h3>Yulius Brown Rudolf</h3><p>Fundador / Entrenador principal</p></div><a href="/es/entrenadores/" aria-label="Conoce a los entrenadores y al equipo">↗</a></div>
  </section>

  <section class="home-cta"><p class="eyebrow">Tu próximo rally empieza aquí</p><h2>¿Listo para jugar<br /><em>con propósito?</em></h2><p>Conversemos sobre el programa adecuado para ti.</p><div class="hero-actions"><a class="button button-light" href="/es/inscripcion/">Únete a PVVA <span aria-hidden="true">↗</span></a><a class="text-link text-link-light" href="https://wa.me/50664880471?text=Hola%20PVVA%2C%20quiero%20informaci%C3%B3n%20para%20unirme.">Escríbenos por WhatsApp <span aria-hidden="true">→</span></a></div></section>
</BaseLayout>