---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AthleteProfile from '../../../components/roster/AthleteProfile.astro';
import { athleteSeasons, listedAthletes, photoSrc, type Athlete } from '../../../data/roster';
import { photoAttrs } from '../../../data/photos';

export function getStaticPaths() {
  return listedAthletes.map((athlete) => ({ params: { athlete: athlete.slug }, props: { athlete } }));
}

const { athlete } = Astro.props as { athlete: Athlete };
const latest = athleteSeasons(athlete.slug)[0];
const position = latest?.entry.position?.es;
const description = [`${athlete.name}${position ? `, ${position.toLowerCase()}` : ''}, atleta de Puerto Viejo Volleyball Academy`, athlete.hometown && `de ${athlete.hometown.es}`].filter(Boolean).join(' ') + '.';
---

<BaseLayout lang="es" title={`${athlete.name} | Atletas PVVA`} description={description} image={photoSrc(athlete) ?? photoAttrs('athletesJump').src} noindex={athlete.sample}>
  <AthleteProfile athlete={athlete} lang="es" />
</BaseLayout>
