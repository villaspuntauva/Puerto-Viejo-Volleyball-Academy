---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageIntro from '../../components/PageIntro.astro';
import Photo from '../../components/Photo.astro';
import { photoAttrs } from '../../data/photos';
import ProgramList from '../../components/programs/ProgramList.astro';
import PricingTable from '../../components/programs/PricingTable.astro';
const description = 'Conoce Puerto Viejo Volleyball Academy: su enfoque de desarrollo en voleibol de playa, programas, precios y ambiente de equipo en Limón, Costa Rica.';
---

<BaseLayout lang="es" title="La academia | Puerto Viejo Volleyball Academy" description={description} image={photoAttrs('teamLineupWide').src}>
  <PageIntro eyebrow="La academia / Puerto Viejo, Costa Rica" title="Desarrolla tu juego. Construye el equipo." description="PVVA es una academia de voleibol de playa en el Caribe de Costa Rica. Desarrollamos atletas mediante entrenamientos estructurados, competencia y un fuerte sentido de equipo." number="01" photo="teamLineupWide" lang="es" />
  <section class="content-section content-section-narrow">
    <p class="eyebrow">Nuestra misión</p>
    <h2>Construir una comunidad duradera de voleibol de playa en el Caribe.</h2>
    <div class="prose-columns"><p>PVVA desarrolla atletas de voleibol de playa en Puerto Viejo y las comunidades cercanas mediante entrenamiento estructurado, trabajo en equipo y competencia. Creamos oportunidades para el talento local y recibimos a atletas y grupos visitantes que quieran entrenar con nosotros.</p><p>Nuestro entrenamiento combina desarrollo técnico, competencia y un ambiente de equipo que brinda apoyo.</p></div>
  </section>
  <section class="content-section program-list-section">
    <div class="section-heading section-heading-compact"><div><p class="eyebrow">Lo que ofrecemos</p><h2>Programas</h2></div><a class="text-link" href="/es/inscripcion/">Consultar cómo unirme <span aria-hidden="true">→</span></a></div>
    <ProgramList lang="es" />
  </section>
  <PricingTable lang="es" />
  <section class="content-section content-section-dark">
    <p class="eyebrow">Aprende. Entrena. Compite.</p><h2>Más que tiempo en la arena.</h2>
    <div class="value-grid"><article><figure class="value-photo"><Photo photo="passingDrill" lang="es" /></figure><span>01</span><h3>Desarrollo del atleta</h3><p>Desarrollar las habilidades técnicas y competitivas que los atletas necesitan para seguir progresando.</p></article><article><figure class="value-photo"><Photo photo="blockJump" lang="es" /></figure><span>02</span><h3>Competencia</h3><p>Conectar el entrenamiento con oportunidades de poner a prueba lo aprendido en torneos y eventos.</p></article><article><figure class="value-photo"><Photo photo="teamHuddle" lang="es" /></figure><span>03</span><h3>Ambiente de equipo</h3><p>Crecer junto a compañeros de equipo y contribuir a una comunidad local de voleibol en crecimiento.</p></article></div>
    <a class="button button-light" href="/es/horarios/">Horarios de entrenamiento <span aria-hidden="true">→</span></a>
  </section>
</BaseLayout>
