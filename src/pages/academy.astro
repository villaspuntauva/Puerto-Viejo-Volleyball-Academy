---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import Photo from '../components/Photo.astro';
import { photoAttrs } from '../data/photos';
import ProgramList from '../components/programs/ProgramList.astro';
import PricingTable from '../components/programs/PricingTable.astro';
const description = 'Learn about Puerto Viejo Volleyball Academy, its beach volleyball development approach, programs, pricing, and team environment in Limón, Costa Rica.';
---

<BaseLayout title="The Academy | Puerto Viejo Volleyball Academy" description={description} image={photoAttrs('teamLineupWide').src}>
  <PageIntro eyebrow="The Academy / Puerto Viejo, Costa Rica" title="Develop the player. Build the game." description="PVVA is a beach volleyball academy in the Caribbean of Costa Rica, developing athletes through structured training, competition, and a strong team environment." number="01" photo="teamLineupWide" />
  <section class="content-section content-section-narrow">
    <p class="eyebrow">Our mission</p>
    <h2>Grow a lasting beach volleyball community in the Caribbean.</h2>
    <div class="prose-columns"><p>PVVA develops beach volleyball athletes in Puerto Viejo and surrounding communities through structured coaching, teamwork, and competition. We create opportunities for local talent while welcoming visiting athletes and groups to train with us.</p><p>Our training combines technical development, competition, and a supportive team environment.</p></div>
  </section>
  <section class="content-section program-list-section">
    <div class="section-heading section-heading-compact"><div><p class="eyebrow">What we offer</p><h2>Programs</h2></div><a class="text-link" href="/join/">Ask about joining <span aria-hidden="true">→</span></a></div>
    <ProgramList />
  </section>
  <PricingTable />
  <section class="content-section content-section-dark">
    <p class="eyebrow">Learn. Train. Compete.</p><h2>More than time on the sand.</h2>
    <div class="value-grid"><article><figure class="value-photo"><Photo photo="passingDrill" /></figure><span>01</span><h3>Athlete development</h3><p>Build the technical and competitive skills athletes need to keep progressing.</p></article><article><figure class="value-photo"><Photo photo="blockJump" /></figure><span>02</span><h3>Competition</h3><p>Connect training with opportunities to test skills through tournaments and events.</p></article><article><figure class="value-photo"><Photo photo="teamHuddle" /></figure><span>03</span><h3>Team environment</h3><p>Develop alongside teammates and contribute to a growing local volleyball community.</p></article></div>
    <a class="button button-light" href="/schedule/">Training hours <span aria-hidden="true">→</span></a>
  </section>
</BaseLayout>