---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import { photoAttrs } from '../data/photos';
import { site } from '../data/site';
const description = 'Contact Puerto Viejo Volleyball Academy in Playa Cocles, Puerto Viejo, Limón, Costa Rica by WhatsApp or email.';
---

<BaseLayout title="Contact PVVA | Puerto Viejo Volleyball Academy" description={description} image={photoAttrs('coastTeam').src}>
  <PageIntro eyebrow="Contact / Puerto Viejo" title="Let’s talk volleyball." description="Questions about training, camps, tournaments, or bringing a team to Puerto Viejo? Get in touch with PVVA." number="09" photo="coastTeam" />
  <section class="contact-layout">
    <div class="contact-main"><p class="eyebrow">Puerto Viejo Volleyball Academy</p><h2>Start a conversation.</h2><div class="contact-options"><a href="mailto:pvvolleyballacademy@gmail.com"><span>Email</span><strong>pvvolleyballacademy@gmail.com</strong><span class="contact-arrow" aria-hidden="true">↗</span></a><a href="https://wa.me/50660196290"><span>WhatsApp</span><strong>+506 6019 6290</strong><span class="contact-arrow" aria-hidden="true">↗</span></a><a href={site.instagramUrl} target="_blank" rel="noopener noreferrer"><span>Instagram</span><strong>{site.instagramHandle}</strong><span class="contact-arrow" aria-hidden="true">↗</span></a><div class="contact-payment"><span>Payments</span><strong>SINPE Móvil or direct bank deposit to +506 6019 6290</strong></div></div></div>
    <div class="contact-location"><p class="eyebrow">Training area</p><h3>Playa Cocles<br />Puerto Viejo, Limón</h3><p>The exact training court pin and directions have not yet been supplied. Confirm the meeting point with PVVA before travelling to a session.</p><a class="text-link" href="https://www.google.com/maps/search/?api=1&query=Playa%20Cocles%2C%20Puerto%20Viejo%20de%20Talamanca%2C%20Lim%C3%B3n%2C%20Costa%20Rica" target="_blank" rel="noreferrer">View Playa Cocles on Google Maps <span aria-hidden="true">↗</span></a></div>
  </section>
  <section class="contact-social"><p class="eyebrow">Stay connected</p><h2>Follow the game.</h2><p>Training, results, and academy news on Instagram.</p><a class="button button-light" href={site.instagramUrl} target="_blank" rel="noopener noreferrer">{site.instagramHandle} <span aria-hidden="true">↗</span></a></section>
</BaseLayout>