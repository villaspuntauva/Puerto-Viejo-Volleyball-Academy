---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
const description = 'Meet the coaching team at Puerto Viejo Volleyball Academy. Coach biographies and verified playing, coaching, and certification details will be added as provided.';
---

<BaseLayout title="Coaches & Staff | Puerto Viejo Volleyball Academy" description={description}>
  <PageIntro eyebrow="Coaches & staff / PVVA" title="The people behind the progress." description="Meet the people building beach volleyball opportunities in Puerto Viejo and the Caribbean of Costa Rica." number="03" />
  <section class="coach-profile">
    <div class="coach-profile-art" aria-hidden="true"><span>PVVA</span><small>COACH<br />PROFILE</small></div>
    <div class="coach-profile-copy"><p class="eyebrow">Founder / Head Coach</p><h2>Yulius Brown Rudolf</h2><p>Founder and head coach of Puerto Viejo Volleyball Academy.</p><p class="profile-note">A full biography, coaching background, playing experience, and certifications will be added when confirmed by the academy.</p><a class="text-link" href="/contact/">Contact the academy <span aria-hidden="true">→</span></a></div>
  </section>
  <section class="content-section content-section-narrow"><p class="eyebrow">Growing the team</p><h2>Coaches, specialists, and visiting talent.</h2><p class="section-lead">This page can grow to include assistant coaches, guest coaches, strength and conditioning staff, and visiting coaches as they join PVVA.</p></section>
</BaseLayout>