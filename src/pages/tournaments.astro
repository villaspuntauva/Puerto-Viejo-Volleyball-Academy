---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
const description = 'See upcoming beach volleyball tournaments hosted by Puerto Viejo Volleyball Academy. Dates, divisions, fees, and registration will be listed when confirmed.';
---

<BaseLayout title="Beach Volleyball Tournaments | Puerto Viejo Volleyball Academy" description={description}>
  <PageIntro eyebrow="Competition / PVVA events" title="Earn every point." description="PVVA-hosted tournaments bring athletes together to compete, learn, and grow the game in the Caribbean of Costa Rica." number="06" />
  <section class="content-section event-list-section">
    <div class="section-heading section-heading-compact"><div><p class="eyebrow">PVVA hosted</p><h2>Upcoming tournaments</h2></div><span class="roster-status">No dates announced</span></div>
    <div class="empty-state"><span class="empty-state-symbol" aria-hidden="true">VS</span><div><h3>Next tournament details are in the works.</h3><p>Divisions, format, entry fee, deadline, and registration will be published once confirmed.</p></div><a class="button button-dark" href="https://wa.me/50664880471?text=Hi%20PVVA%2C%20please%20let%20me%20know%20when%20the%20next%20tournament%20is%20announced.">Ask about tournaments <span aria-hidden="true">↗</span></a></div>
  </section>
  <section class="content-section content-section-muted"><p class="eyebrow">Looking to compete?</p><h2>Start with the academy.</h2><p class="section-lead">Ask about current training opportunities and how to prepare for upcoming competition.</p><a class="text-link" href="/join/">Join PVVA <span aria-hidden="true">→</span></a></section>
</BaseLayout>