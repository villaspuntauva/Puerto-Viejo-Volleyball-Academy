---
import BaseLayout from '../layouts/BaseLayout.astro';
import { programs } from '../data/programs';

const description =
  'Puerto Viejo Volleyball Academy develops beach volleyball athletes through training, competition, and community in Playa Cocles, Puerto Viejo, Costa Rica.';
const organization = {
  '@context': 'https://schema.org',
  '@type': 'SportsOrganization',
  name: 'Puerto Viejo Volleyball Academy',
  alternateName: 'PVVA',
  url: 'https://www.pvvolleyballacademy.com/',
  description,
  email: 'pvvolleyballacademy@gmail.com',
  telephone: '+506 6488 0471',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Puerto Viejo de Talamanca',
    addressRegion: 'Limón',
    addressCountry: 'CR',
  },
  areaServed: ['Puerto Viejo', 'Limón', 'Costa Rica', 'Caribbean'],
};
---

<BaseLayout title="Puerto Viejo Volleyball Academy | Beach Volleyball in Costa Rica" description={description} image="https://images.unsplash.com/photo-1592656094267-764a45160876?auto=format&fit=crop&w=1200&q=80" structuredData={organization}>
  <section class="home-hero" aria-labelledby="hero-title">
    <img
      class="hero-photo"
      src="https://images.unsplash.com/photo-1592656094267-764a45160876?auto=format&fit=crop&w=1600&q=80"
      srcset="https://images.unsplash.com/photo-1592656094267-764a45160876?auto=format&fit=crop&w=640&q=75 640w, https://images.unsplash.com/photo-1592656094267-764a45160876?auto=format&fit=crop&w=1000&q=78 1000w, https://images.unsplash.com/photo-1592656094267-764a45160876?auto=format&fit=crop&w=1600&q=80 1600w"
      sizes="100vw"
      alt="Beach volleyball resting near the net on a sand court"
      width="2200"
      height="1467"
      fetchpriority="high"
    />
    <div class="hero-shade"></div>
    <div class="hero-content">
      <p class="hero-kicker">Puerto Viejo Volleyball Academy</p>
      <h1 id="hero-title">Train.<br />Compete.<br /><em>Grow.</em></h1>
      <p class="hero-description">Beach volleyball development in the Caribbean of Costa Rica.</p>
      <div class="hero-actions">
        <a class="button button-light" href="/join/">Join PVVA <span aria-hidden="true">↗</span></a>
        <a class="text-link text-link-light" href="/academy/">Discover the academy <span aria-hidden="true">→</span></a>
      </div>
    </div>
    <div class="hero-side-note">Beach volleyball development <span>Playa Cocles · Limón · Costa Rica</span></div>
    <div class="draft-label">Draft image · replace with PVVA photography</div>
  </section>

  <section class="intro-band">
    <div class="section-index">01 / THE ACADEMY</div>
    <div class="intro-content">
      <p class="eyebrow">A place to develop</p>
      <h2>Serious beach volleyball.<br /><span>Rooted in the Caribbean.</span></h2>
      <div class="intro-columns">
        <p>Puerto Viejo Volleyball Academy is building a beach volleyball environment in the Caribbean of Costa Rica where athletes can train, develop, and compete.</p>
        <p>From developing players to advanced competitors, PVVA brings athletes together through structured training and a strong team culture.</p>
      </div>
      <a class="text-link" href="/academy/">How the academy works <span aria-hidden="true">→</span></a>
    </div>
    <div class="intro-stamp" aria-hidden="true"><span>PVVA</span><small>CARIBBEAN<br />COSTA RICA</small></div>
  </section>

  <section class="program-section" aria-labelledby="programs-title">
    <div class="section-heading">
      <div><p class="eyebrow">Find your pathway</p><h2 id="programs-title">Built around<br /><em>your next step.</em></h2></div>
      <p>Different athletes. Different goals. A shared commitment to getting better.</p>
    </div>
    <div class="program-grid">
      {programs.map((program) => (
        <article class="program-card">
          <span class="program-number">{program.number}</span>
          <div>
            <p class="program-audience">{program.audience}</p>
            <h3>{program.name}</h3>
            <p>{program.description}</p>
          </div>
          <span class="program-status">{program.status}</span>
        </article>
      ))}
    </div>
    <a class="text-link" href="/academy/">Explore all programs <span aria-hidden="true">→</span></a>
  </section>

  <section class="split-feature" aria-labelledby="destination-title">
    <div class="feature-image-wrap">
      <img
        src="https://images.unsplash.com/photo-1504450758481-7338eba7524a?auto=format&fit=crop&w=1200&q=80"
        srcset="https://images.unsplash.com/photo-1504450758481-7338eba7524a?auto=format&fit=crop&w=640&q=75 640w, https://images.unsplash.com/photo-1504450758481-7338eba7524a?auto=format&fit=crop&w=1200&q=80 1200w"
        sizes="(max-width: 820px) 100vw, 54vw"
        alt="Volleyball net set up on a sandy beach"
        width="1200"
        height="900"
        loading="lazy"
      />
      <span class="image-caption">THE CARIBBEAN COAST · COSTA RICA</span>
      <span class="draft-label draft-label-image">Draft image</span>
    </div>
    <div class="feature-copy">
      <p class="eyebrow">Train in the Caribbean</p>
      <h2 id="destination-title">A different place<br />to play. A serious<br /><em>place to grow.</em></h2>
      <p>PVVA's long-term vision is to welcome athletes, teams, and coaches to Puerto Viejo for focused beach volleyball training, camps, and competition.</p>
      <a class="button button-outline" href="/camps/">Explore camps <span aria-hidden="true">↗</span></a>
    </div>
  </section>

  <section class="whats-on" aria-labelledby="whats-on-title">
    <div class="section-heading section-heading-compact">
      <div><p class="eyebrow">On the sand</p><h2 id="whats-on-title">What's happening</h2></div>
      <a class="text-link" href="/events/">Events &amp; updates <span aria-hidden="true">→</span></a>
    </div>
    <div class="event-placeholder">
      <span class="event-mark" aria-hidden="true">PVVA<br />NEWS</span>
      <div><p class="eyebrow">Updates coming soon</p><h3>Follow the academy as it grows.</h3><p>Upcoming camps, tournaments, and special sessions will be announced here.</p></div>
      <a class="button button-dark" href="https://wa.me/50664880471?text=Hi%20PVVA%2C%20I%27d%20like%20to%20hear%20about%20upcoming%20events.">Ask about upcoming events <span aria-hidden="true">↗</span></a>
    </div>
  </section>

  <section class="coach-strip" aria-labelledby="coach-title">
    <div class="coach-number">PVVA<br />PEOPLE</div>
    <div><p class="eyebrow">The people behind the program</p><h2 id="coach-title">Built by the<br /><em>volleyball community.</em></h2></div>
    <div class="coach-highlight"><span class="coach-initials" aria-hidden="true">YB</span><div><h3>Yulius Brown Rudolf</h3><p>Founder / Head Coach</p></div><a href="/coaches/" aria-label="Meet the coaches and staff">↗</a></div>
  </section>

  <section class="home-cta">
    <p class="eyebrow">Your next rally starts here</p>
    <h2>Ready to play<br /><em>with purpose?</em></h2>
    <p>Start a conversation with PVVA about the right program for you.</p>
    <div class="hero-actions">
      <a class="button button-light" href="/join/">Join PVVA <span aria-hidden="true">↗</span></a>
      <a class="text-link text-link-light" href="https://wa.me/50664880471?text=Hi%20PVVA%2C%20I%27d%20like%20to%20learn%20about%20joining.">WhatsApp us <span aria-hidden="true">→</span></a>
    </div>
  </section>
</BaseLayout>