---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
const description = 'Meet the athletes developing and competing with Puerto Viejo Volleyball Academy. Athlete profiles will be published with player and guardian approval.';
---

<BaseLayout title="Athletes | Puerto Viejo Volleyball Academy" description={description}>
  <PageIntro eyebrow="The roster / PVVA" title="Every athlete has a next step." description="PVVA brings together developing and competitive beach volleyball athletes from Puerto Viejo and the wider region." number="02" />
  <section class="content-section roster-section">
    <div class="section-heading section-heading-compact"><div><p class="eyebrow">Competitive pathway</p><h2>Premier</h2></div><span class="roster-status">Roster in development</span></div>
    <p class="section-lead">The Premier roster will highlight athletes training toward higher-level competition. Profiles will be added with athlete and, where needed, guardian consent.</p>
    <div class="empty-state"><span class="empty-state-symbol" aria-hidden="true">01</span><div><h3>Player profiles are coming soon.</h3><p>For current program availability, contact the academy directly.</p></div><a class="text-link" href="/contact/">Contact PVVA <span aria-hidden="true">→</span></a></div>
  </section>
  <section class="content-section roster-section roster-section-muted">
    <div class="section-heading section-heading-compact"><div><p class="eyebrow">Developing athletes</p><h2>Future</h2></div><span class="roster-status">Roster in development</span></div>
    <p class="section-lead">Future is for younger and developing athletes growing their skills, confidence, and love of the game.</p>
    <div class="empty-state"><span class="empty-state-symbol" aria-hidden="true">02</span><div><h3>Player profiles are coming soon.</h3><p>Ask us about age groups and training pathways.</p></div><a class="text-link" href="/join/">Ask about Future <span aria-hidden="true">→</span></a></div>
  </section>
</BaseLayout>